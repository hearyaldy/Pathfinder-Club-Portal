rules_version = '2';

// v1 rules. The existing app is a public club portal: guests can look up their
// own membership pass, self check-in via QR at the door, browse the calendar,
// and register a new youth member — none of that required login before, and
// none of it should start requiring login now. The two real upgrades in this
// pass are: (1) leaders need an actual password instead of picking a name
// from a list, and (2) a public registration can't grant itself Approved
// status. Finer-grained protection of medical/contact data is planned
// separately (see the Firebase migration plan) and isn't a v1 blocker.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /divisions/{divisionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{memberId} {
      allow read: if true;
      // Public self-registration, but a client can't set itself Approved.
      allow create: if request.resource.data.registrationStatus == 'Pending Review';
      allow update, delete: if request.auth != null;
    }

    // Public read/write: self check-in via QR pass is an unauthenticated
    // guest feature in this app (QrScannerModal is reachable from the public
    // Guest Portal and Member Hub, not just the staff nav).
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // BEGIN scoring rules
    function canManageScores(orgId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && profile.role in [
        'Super Admin', 'Mission Youth Director', 'District Coordinator',
        'Church Pastor', 'Club Director', 'Club Secretary', 'Unit Counselor'
      ] && (profile.orgId == orgId || profile.role in ['Super Admin', 'Mission Youth Director', 'District Coordinator']);
    }

    function validScore(value, maximum) {
      return value is int && value >= 0 && value <= maximum;
    }

    function scoreAttendance(eventId, memberId) {
      let attendancePath = /databases/$(database)/documents/attendance/$(eventId + '_' + memberId);
      return exists(attendancePath) && get(attendancePath).data.status in ['Present', 'Late'] ? 10 : 0;
    }

    function validEvaluation(data, evaluationId) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let member = get(/databases/$(database)/documents/members/$(data.memberId)).data;
      let investiture = event.type == 'Investiture';
      let bonus = data.get('investitureBonusScore', 0);
      return data.keys().hasAll(['id', 'orgId', 'eventId', 'memberId', 'attendanceScore', 'marchingDrillScore', 'uniformScore', 'disciplineScore', 'totalScore', 'maxScore', 'evaluatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'eventId', 'memberId', 'unitId', 'attendanceScore', 'marchingDrillScore', 'uniformScore', 'disciplineScore', 'investitureBonusScore', 'totalScore', 'maxScore', 'notes', 'evaluatedAt'])
        && data.id == evaluationId && evaluationId == data.eventId + '_' + data.memberId
        && data.orgId == event.orgId && data.orgId == member.orgId
        && !event.keys().hasAny(['deletedAt'])
        && member.registrationStatus == 'Approved'
        && (event.branch == 'Both' || member.branch == event.branch || member.branch == 'Staff')
        && data.get('unitId', '') == member.get('unitId', '')
        && validScore(data.marchingDrillScore, 20) && validScore(data.uniformScore, 20) && validScore(data.disciplineScore, 20)
        && validScore(bonus, 10) && (investiture || !data.keys().hasAny(['investitureBonusScore']))
        && data.attendanceScore == scoreAttendance(data.eventId, data.memberId)
        && data.maxScore == (investiture ? 80 : 70)
        && data.totalScore == data.attendanceScore + data.marchingDrillScore + data.uniformScore + data.disciplineScore + bonus
        && data.get('notes', '') is string && data.evaluatedAt is string;
    }

    match /evaluations/{evaluationId} {
      allow read: if canManageScores(resource.data.orgId);
      allow create: if canManageScores(request.resource.data.orgId) && validEvaluation(request.resource.data, evaluationId);
      allow update: if resource.data.orgId == request.resource.data.orgId && canManageScores(request.resource.data.orgId) && validEvaluation(request.resource.data, evaluationId);
    }
    // END scoring rules

    match /users/{uid} {
      allow read: if request.auth != null;
      // Leaders can create/edit their own profile; a Super Admin can manage anyone's.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
