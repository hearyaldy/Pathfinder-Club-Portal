rules_version = '2';

// v1 rules. The existing app is a public club portal: guests can look up their
// own membership pass, self check-in via QR at the door, browse the calendar,
// and register a new youth member — none of that required login before, and
// none of it should start requiring login now. The two real upgrades in this
// pass are: (1) leaders need an actual password instead of picking a name
// from a list, and (2) a public registration can't grant itself Approved
// status. Finer-grained protection of medical/contact data is planned
// separately (see the Firebase migration plan) and isn't a v1 blocker.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /divisions/{divisionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{memberId} {
      allow read: if true;
      // Public self-registration, but a client can't set itself Approved.
      allow create: if request.resource.data.registrationStatus == 'Pending Review';
      allow update, delete: if request.auth != null;
    }

    // Public read/write: self check-in via QR pass is an unauthenticated
    // guest feature in this app (QrScannerModal is reachable from the public
    // Guest Portal and Member Hub, not just the staff nav).
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // BEGIN scoring rules
    function canManageScores(orgId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && profile.role in [
        'Super Admin', 'Mission Youth Director', 'District Coordinator',
        'Church Pastor', 'Club Director', 'Club Secretary', 'Unit Counselor'
      ] && (profile.orgId == orgId || profile.role in ['Super Admin', 'Mission Youth Director', 'District Coordinator']);
    }

    function validScore(value, maximum) {
      return value is int && value >= 0 && value <= maximum;
    }

    function scoreAttendance(eventId, memberId) {
      let attendancePath = /databases/$(database)/documents/attendance/$(eventId + '_' + memberId);
      return exists(attendancePath) && get(attendancePath).data.status in ['Present', 'Late'] ? 10 : 0;
    }

    // Member scoresheet: Attendance (10 pts, auto) + 8 uniform items ticked
    // pass/fail, splitting whatever's left of the 70 (80 for Investiture)
    // full mark evenly between them.
    function validEvaluation(data, evaluationId) {
      let event = get(/databases/$(database)/documents/events/$(data.eventId)).data;
      let member = get(/databases/$(database)/documents/members/$(data.memberId)).data;
      let maxScore = event.type == 'Investiture' ? 80 : 70;
      // 8.0 forces float division — Firestore rules do integer (truncating) division
      // between two ints, unlike JavaScript, which silently broke every score.
      let perItem = (maxScore - 10) / 8.0;
      return data.keys().hasAll(['id', 'orgId', 'eventId', 'memberId', 'attendanceScore', 'topsPass', 'pantsPass', 'beltPass', 'socksPass', 'shoesPass', 'neckerchiefPass', 'sliderPass', 'capCordSashPatchesPass', 'totalScore', 'maxScore', 'evaluatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'eventId', 'memberId', 'unitId', 'attendanceScore', 'topsPass', 'pantsPass', 'beltPass', 'socksPass', 'shoesPass', 'neckerchiefPass', 'sliderPass', 'capCordSashPatchesPass', 'totalScore', 'maxScore', 'notes', 'evaluatedAt'])
        && data.id == evaluationId && evaluationId == data.eventId + '_' + data.memberId
        && data.orgId == event.orgId && data.orgId == member.orgId
        && !event.keys().hasAny(['deletedAt'])
        && member.registrationStatus == 'Approved'
        && (event.branch == 'Both' || member.branch == event.branch || member.branch == 'Staff')
        && data.get('unitId', '') == member.get('unitId', '')
        && data.topsPass is bool && data.pantsPass is bool && data.beltPass is bool && data.socksPass is bool
        && data.shoesPass is bool && data.neckerchiefPass is bool && data.sliderPass is bool && data.capCordSashPatchesPass is bool
        && data.attendanceScore == scoreAttendance(data.eventId, data.memberId)
        && data.maxScore == maxScore
        && data.totalScore == data.attendanceScore
          + (data.topsPass ? perItem : 0) + (data.pantsPass ? perItem : 0) + (data.beltPass ? perItem : 0) + (data.socksPass ? perItem : 0)
          + (data.shoesPass ? perItem : 0) + (data.neckerchiefPass ? perItem : 0) + (data.sliderPass ? perItem : 0) + (data.capCordSashPatchesPass ? perItem : 0)
        && data.get('notes', '') is string && data.evaluatedAt is string;
    }

    match /evaluations/{evaluationId} {
      allow read: if canManageScores(resource.data.orgId);
      allow create: if canManageScores(request.resource.data.orgId) && validEvaluation(request.resource.data, evaluationId);
      allow update: if resource.data.orgId == request.resource.data.orgId && canManageScores(request.resource.data.orgId) && validEvaluation(request.resource.data, evaluationId);
    }

    // Marching & Drill scoresheet: one evaluator scores a whole unit on 14
    // commands (0-10 each, 140 max), minus two uncapped demerit deductions.
    function validDrillEvaluation(data, evaluationId) {
      let unit = get(/databases/$(database)/documents/units/$(data.unitId)).data;
      let commandSum = data.fallIn + data.coverDressRightDress + data.recoverReadyFront + data.paradeRest
        + data.countOff + data.attention + data.leftRightFace + data.aboutFace + data.markTimeMarch
        + data.forwardMarch + data.readyHalt + data.presentArms + data.orderArms + data.dismiss;
      let netScore = commandSum - data.demeritUnitCaptain - data.demeritMembers;
      return data.keys().hasAll(['id', 'orgId', 'eventId', 'unitId', 'evaluatorName', 'fallIn', 'coverDressRightDress', 'recoverReadyFront', 'paradeRest', 'countOff', 'attention', 'leftRightFace', 'aboutFace', 'markTimeMarch', 'forwardMarch', 'readyHalt', 'presentArms', 'orderArms', 'dismiss', 'demeritUnitCaptain', 'demeritMembers', 'commandSubtotal', 'totalScore', 'maxScore', 'evaluatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'eventId', 'unitId', 'evaluatorName', 'fallIn', 'coverDressRightDress', 'recoverReadyFront', 'paradeRest', 'countOff', 'attention', 'leftRightFace', 'aboutFace', 'markTimeMarch', 'forwardMarch', 'readyHalt', 'presentArms', 'orderArms', 'dismiss', 'demeritUnitCaptain', 'demeritMembers', 'commandSubtotal', 'totalScore', 'maxScore', 'evaluatedAt'])
        // Doc ids are opaque per-submission now (multiple evaluators per unit+event), just self-consistent.
        && data.id == evaluationId
        && data.orgId == unit.orgId
        && data.evaluatorName is string && data.evaluatorName.size() > 0
        && validScore(data.fallIn, 10) && validScore(data.coverDressRightDress, 10) && validScore(data.recoverReadyFront, 10)
        && validScore(data.paradeRest, 10) && validScore(data.countOff, 10) && validScore(data.attention, 10)
        && validScore(data.leftRightFace, 10) && validScore(data.aboutFace, 10) && validScore(data.markTimeMarch, 10)
        && validScore(data.forwardMarch, 10) && validScore(data.readyHalt, 10) && validScore(data.presentArms, 10)
        && validScore(data.orderArms, 10) && validScore(data.dismiss, 10)
        && data.demeritUnitCaptain is number && data.demeritUnitCaptain >= 0
        && data.demeritMembers is number && data.demeritMembers >= 0
        && data.commandSubtotal == commandSum
        && data.maxScore == 140
        && data.totalScore == (netScore > 0 ? netScore : 0)
        && data.evaluatedAt is string;
    }

    match /unitDrillScores/{evaluationId} {
      allow read: if canManageScores(resource.data.orgId);
      allow create: if canManageScores(request.resource.data.orgId) && validDrillEvaluation(request.resource.data, evaluationId);
      allow update: if resource.data.orgId == request.resource.data.orgId && canManageScores(request.resource.data.orgId) && validDrillEvaluation(request.resource.data, evaluationId);
    }
    // END scoring rules

    // Advancement record (Class + Honors) — leader-only, no public surface touches this.
    match /memberHonors/{honorId} {
      allow read: if canManageScores(resource.data.orgId);
      allow create: if canManageScores(request.resource.data.orgId);
      allow update, delete: if canManageScores(resource.data.orgId);
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      // Leaders can create/edit their own profile; a Super Admin can manage anyone's.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }
  }
}
